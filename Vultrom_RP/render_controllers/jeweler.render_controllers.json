{
	"format_version": "1.8.0",
	"render_controllers": {
		"controller.render.vultrom_jeweler": {
			"geometry": "Geometry.default",
			"materials": [{ "*": "Material.default" }],
			"textures": ["Texture.default"],
			"part_visibility": [
				{ "*": true },
				{ "held_sapphire": "query.property('vultrom:held_gem') == 1" },
				{ "held_ruby": "query.property('vultrom:held_gem') == 2" }
			]
		}
	}
}
